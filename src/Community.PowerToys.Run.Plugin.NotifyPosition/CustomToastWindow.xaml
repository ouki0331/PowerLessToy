<Window x:Class="Community.PowerToys.Run.Plugin.NotifyPosition.CustomToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification"
        Width="410" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Focusable="False">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="ToastActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="8" BorderBrush="#3A3A3C" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToastPrimaryButton" TargetType="Button" BasedOn="{StaticResource ToastActionButton}">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="8" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0071E3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16" Background="#1C1C1E" CornerRadius="16" BorderBrush="#3A3A3C" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="16" Cursor="Hand" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: App Name badge, Time, Close button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2C2C2E" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtAppName" Text="システム通知" FontSize="11" Foreground="#0A84FF" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="TxtTime" Text="今" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Width="24" Height="24" FontSize="11"
                        Foreground="#8E8E93" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <!-- Title -->
            <TextBlock x:Name="TxtTitle" Grid.Row="1" Text="タイトル" FontSize="14" FontWeight="SemiBold"
                       Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,8,0,3"/>

            <!-- Body -->
            <TextBlock x:Name="TxtBody" Grid.Row="2" Text="通知メッセージ内容" FontSize="12"
                       Foreground="#D1D1D6" TextWrapping="Wrap" MaxHeight="80" LineHeight="17"/>

            <!-- Action Buttons Container (Dynamic) -->
            <StackPanel x:Name="ButtonContainer" Grid.Row="3" Orientation="Horizontal" 
                        HorizontalAlignment="Right" Margin="0,12,0,0"/>
        </Grid>
    </Border>
</Window>
