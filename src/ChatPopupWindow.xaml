<Window x:Class="NotifyPositionChanger.ChatPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Chat - メッセージ"
        Width="520" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="400" MinHeight="350"
        Background="{StaticResource PrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="True">

    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000" />
    </Window.Effect>

    <Border CornerRadius="12" Background="{StaticResource PrimaryBrush}"
            BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1.5"
            Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ヘッダー -->
            <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}"
                    CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="💬" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderSender" Text="Google Chat" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="HeaderSpace" Text="" FontSize="10"
                                       Foreground="{StaticResource SubTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <Button Content="✕" Width="32" Height="28" FontSize="12"
                                Style="{StaticResource ModernButton}" Click="Close_Click"
                                Background="Transparent" ToolTip="閉じる" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- メッセージ一覧 -->
            <Border Grid.Row="1" Margin="12,8,12,4">
                <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessagePanel" />
                </ScrollViewer>
            </Border>

            <!-- 返信入力エリア -->
            <Border Grid.Row="2" Background="{StaticResource SecondaryBrush}"
                    CornerRadius="0,0,12,12" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ReplyTextBox" Grid.Column="0"
                             Style="{StaticResource ModernTextBox}"
                             AcceptsReturn="False"
                             KeyDown="ReplyTextBox_KeyDown"
                             VerticalAlignment="Center"
                             FontSize="13" />

                    <Button x:Name="SendButton" Grid.Column="2"
                            Content="送信" Style="{StaticResource ModernButton}"
                            Width="70" Click="Send_Click"
                            Background="{StaticResource HighlightBrush}" />
                </Grid>
            </Border>

            <!-- 送信中オーバーレイ -->
            <Border x:Name="SendingOverlay" Grid.RowSpan="3"
                    Background="#CC1A1A2E" CornerRadius="12"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="送信中..." FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource HighlightBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
