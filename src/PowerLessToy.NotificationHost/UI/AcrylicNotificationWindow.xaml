<Window x:Class="PowerLessToy.NotifyPosition.UI.AcrylicNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification"
        Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Focusable="False"
        ShowActivated="False">

    <Window.Resources>
        <Style x:Key="MacCloseButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToastActionButton" TargetType="Button">
            <Setter Property="Background" Value="#332C2C2E"/>
            <Setter Property="Foreground" Value="#E5FFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="0.8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#553A3A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToastPrimaryButton" TargetType="Button" BasedOn="{StaticResource ToastActionButton}">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="8" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0071E3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout" Margin="10">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="WindowTransform" Y="0" X="0"/>
        </Grid.RenderTransform>

        <!-- macOS-like frosted glass card -->
        <Border x:Name="CardBorder" Background="#B81C1C20" CornerRadius="16" BorderBrush="#38FFFFFF" BorderThickness="1"
                Cursor="Hand" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.38" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="14,12,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: App Icon, App Name, Time, Close -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- App Icon -->
                        <Border Width="20" Height="20" CornerRadius="5" Background="#0A84FF" Margin="0,0,8,0" VerticalAlignment="Center" ClipToBounds="True">
                            <Image x:Name="ImgAppIcon" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <!-- App Name -->
                        <TextBlock x:Name="TxtAppName" Text="システム通知" FontSize="12" Foreground="#F2FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <!-- Time -->
                        <TextBlock x:Name="TxtTime" Text="今" FontSize="11" Foreground="#8E8E93" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Column="2" Style="{StaticResource MacCloseButton}" Content="✕" FontSize="10" Click="Close_Click"/>
                </Grid>

                <!-- Title -->
                <TextBlock x:Name="TxtTitle" Grid.Row="1" Text="タイトル" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,7,0,2"/>

                <!-- Body -->
                <TextBlock x:Name="TxtBody" Grid.Row="2" Text="通知メッセージ" FontSize="12"
                           Foreground="#D1D1D6" TextWrapping="Wrap" MaxHeight="80" LineHeight="17"/>

                <!-- Action Buttons Container -->
                <StackPanel x:Name="ButtonContainer" Grid.Row="3" Orientation="Horizontal" 
                            HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
