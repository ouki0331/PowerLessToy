<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(PowerLessToyTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>NotifyPositionChanger</RootNamespace>
    <AssemblyName>NotifyPositionChanger</AssemblyName>
    <Nullable>enable</Nullable>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Google.Apis.HangoutsChat.v1" Version="1.68.0.3666" />
    <PackageReference Include="Google.Apis.Auth" Version="1.68.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Community.*/**" />
    <Compile Remove="PowerLessToy.*/**" />
    <Page Remove="Community.*/**" />
    <Page Remove="PowerLessToy.*/**" />
    <None Remove="Community.*/**" />
    <None Remove="PowerLessToy.*/**" />
  </ItemGroup>

</Project>
